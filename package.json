{
  "name": "nobcn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "bun run registry:build && next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome check --write",
    "registry:build": "bun run themes:build && shadcn build registry.json --output public/r",
    "storybook": "storybook dev -p 6010",
    "build-storybook": "storybook build --disable-telemetry",
    "typecheck": "tsc --noEmit",
    "test:stories": "vitest run --project=storybook",
    "check": "bun run lint && bun run typecheck && bun run test:stories",
    "themes:build": "bun scripts/build-themes.ts && biome format --write registry.json public/themes"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/baloo-2": "5.3.0",
    "@fontsource-variable/fira-code": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.542.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/nextjs-vite": "10.6.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "playwright": "1.63.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.3.7",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  },
  "type": "module",
  "packageManager": "bun@1.3.14"
}
