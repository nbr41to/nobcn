{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme-ai",
  "title": "nobcn / 藍",
  "description": "日本語UI向けテーマトークン。ライト・ダーク両対応。",
  "dependencies": [
    "@fontsource-variable/noto-sans-jp",
    "@fontsource-variable/baloo-2",
    "@fontsource-variable/fira-code"
  ],
  "cssVars": {
    "light": {
      "radius": "0.875rem",
      "background": "oklch(0.991 0.003 95)",
      "foreground": "oklch(0.24 0.012 85)",
      "card": "oklch(1 0 0)",
      "card-foreground": "var(--foreground)",
      "popover": "var(--card)",
      "popover-foreground": "var(--foreground)",
      "primary": "oklch(0.45 0.15 265)",
      "primary-foreground": "oklch(0.99 0 0)",
      "secondary": "oklch(0.95 0.008 95)",
      "secondary-foreground": "var(--foreground)",
      "muted": "oklch(0.96 0.006 95)",
      "muted-foreground": "oklch(0.49 0.016 85)",
      "accent": "oklch(0.94 0.027 265)",
      "accent-foreground": "oklch(0.4 0.13 265)",
      "destructive": "oklch(0.52 0.2 27)",
      "border": "oklch(0.9 0.009 95)",
      "input": "oklch(0.84 0.013 95)",
      "ring": "oklch(0.56 0.15 265)",
      "brand": "var(--primary)",
      "hero-background": "var(--accent)",
      "hero-foreground": "var(--foreground)",
      "hero-muted": "var(--muted-foreground)",
      "surface-shadow": "0 1px 3px rgb(0 0 0 / 4%)",
      "font-sans": "\"Noto Sans JP Variable\", -apple-system, BlinkMacSystemFont,\n    \"Hiragino Kaku Gothic ProN\", \"Yu Gothic\", Meiryo, sans-serif",
      "font-mono": "\"Fira Code Variable\", \"SFMono-Regular\", Consolas, monospace",
      "font-heading": "\"Baloo 2 Variable\", \"Noto Sans JP Variable\", sans-serif"
    },
    "dark": {
      "radius": "0.875rem",
      "background": "oklch(0.18 0.009 145)",
      "foreground": "oklch(0.94 0.008 95)",
      "card": "oklch(0.215 0.009 145)",
      "card-foreground": "var(--foreground)",
      "popover": "var(--card)",
      "popover-foreground": "var(--foreground)",
      "primary": "oklch(0.8 0.1 265)",
      "primary-foreground": "oklch(0.23 0.06 265)",
      "secondary": "oklch(0.28 0.012 145)",
      "secondary-foreground": "var(--foreground)",
      "muted": "oklch(0.25 0.01 145)",
      "muted-foreground": "oklch(0.72 0.012 95)",
      "accent": "oklch(0.3 0.05 265)",
      "accent-foreground": "oklch(0.87 0.06 265)",
      "destructive": "oklch(0.76 0.14 27)",
      "border": "oklch(0.33 0.012 145)",
      "input": "oklch(0.42 0.014 145)",
      "ring": "oklch(0.75 0.1 265)",
      "brand": "var(--primary)",
      "hero-background": "var(--accent)",
      "hero-foreground": "var(--foreground)",
      "hero-muted": "var(--muted-foreground)",
      "surface-shadow": "0 1px 3px rgb(0 0 0 / 10%)",
      "font-sans": "\"Noto Sans JP Variable\", -apple-system, BlinkMacSystemFont,\n    \"Hiragino Kaku Gothic ProN\", \"Yu Gothic\", Meiryo, sans-serif",
      "font-mono": "\"Fira Code Variable\", \"SFMono-Regular\", Consolas, monospace",
      "font-heading": "\"Baloo 2 Variable\", \"Noto Sans JP Variable\", sans-serif"
    }
  },
  "css": {
    "@import \"@fontsource-variable/noto-sans-jp\"": {},
    "@import \"@fontsource-variable/baloo-2\"": {},
    "@import \"@fontsource-variable/fira-code\"": {}
  },
  "type": "registry:theme"
}