{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme-noblog",
  "title": "nobcn / noblog",
  "description": "noblogのオレンジの紙面・ネイビーの文字・丸い英字を受け継ぐテーマ。ダーク配色は新規設計。",
  "dependencies": [
    "@fontsource-variable/noto-sans-jp",
    "@fontsource-variable/baloo-2",
    "@fontsource-variable/fira-code"
  ],
  "cssVars": {
    "light": {
      "radius": "0.5rem",
      "background": "#ffedd5",
      "foreground": "#1e293b",
      "card": "#fff7ed",
      "card-foreground": "var(--foreground)",
      "popover": "#fff7ed",
      "popover-foreground": "var(--foreground)",
      "primary": "#c2410c",
      "primary-foreground": "#ffffff",
      "secondary": "#fed7aa",
      "secondary-foreground": "#1e293b",
      "muted": "#fde4c4",
      "muted-foreground": "#665344",
      "accent": "#fed7aa",
      "accent-foreground": "#7c2d12",
      "destructive": "#b91c1c",
      "border": "#d8bfa1",
      "input": "#a89078",
      "ring": "#c2410c",
      "brand": "#f97316",
      "hero-background": "#1e293b",
      "hero-foreground": "#ffedd5",
      "hero-muted": "#e2cdb5",
      "surface-shadow": "2px 2px 0 rgb(30 41 59 / 18%)",
      "font-sans": "\"Noto Sans JP Variable\", -apple-system, BlinkMacSystemFont,\n    \"Hiragino Kaku Gothic ProN\", \"Yu Gothic\", Meiryo, sans-serif",
      "font-mono": "\"Fira Code Variable\", \"SFMono-Regular\", Consolas, monospace",
      "font-heading": "\"Baloo 2 Variable\", \"Noto Sans JP Variable\", sans-serif"
    },
    "dark": {
      "radius": "0.5rem",
      "background": "#141e2e",
      "foreground": "#ffedd5",
      "card": "#1e293b",
      "card-foreground": "var(--foreground)",
      "popover": "#1e293b",
      "popover-foreground": "var(--foreground)",
      "primary": "#fb923c",
      "primary-foreground": "#1e293b",
      "secondary": "#334155",
      "secondary-foreground": "#ffedd5",
      "muted": "#263348",
      "muted-foreground": "#c4b8aa",
      "accent": "#493124",
      "accent-foreground": "#fed7aa",
      "destructive": "#fca5a5",
      "border": "#475569",
      "input": "#64748b",
      "ring": "#fb923c",
      "brand": "#fb923c",
      "hero-background": "#1e293b",
      "hero-foreground": "#ffedd5",
      "hero-muted": "#e2cdb5",
      "surface-shadow": "2px 2px 0 rgb(0 0 0 / 30%)",
      "font-sans": "\"Noto Sans JP Variable\", -apple-system, BlinkMacSystemFont,\n    \"Hiragino Kaku Gothic ProN\", \"Yu Gothic\", Meiryo, sans-serif",
      "font-mono": "\"Fira Code Variable\", \"SFMono-Regular\", Consolas, monospace",
      "font-heading": "\"Baloo 2 Variable\", \"Noto Sans JP Variable\", sans-serif"
    }
  },
  "css": {
    "@import \"@fontsource-variable/noto-sans-jp\"": {},
    "@import \"@fontsource-variable/baloo-2\"": {},
    "@import \"@fontsource-variable/fira-code\"": {}
