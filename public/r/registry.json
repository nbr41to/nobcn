{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "nobcn",
  "homepage": "https://github.com/nbr41to/nobcn",
  "items": [
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "主操作・補助操作・取り消しを、視覚的な優先順位で整理します。Base UIのキーボード操作とフォーカス管理を利用します。",
      "dependencies": [
        "cn",
        "@base-ui/react",
        "class-variance-authority",
        "lucide-react"
      ],
      "files": [
        {
          "path": "src/components/ui/button.tsx",
          "type": "registry:ui",
          "target": "@ui/button.tsx"
        }
      ]
    },
    {
      "name": "input",
      "type": "registry:ui",
      "title": "Input",
      "description": "Base UIのInputを使う最小の入力プリミティブです。日本語の入力例、補足文、エラーまで必要な場合はForm Fieldを使います。",
      "dependencies": [
        "cn",
        "@base-ui/react",
        "class-variance-authority",
        "lucide-react"
      ],
      "files": [
        {
          "path": "src/components/ui/input.tsx",
          "type": "registry:ui",
          "target": "@ui/input.tsx"
        }
      ]
    },
    {
      "name": "badge",
      "type": "registry:ui",
      "title": "Badge",
      "description": "公開・下書き・確認中など、短い状態表示に使います。色に加えてテキストを持たせます。",
      "dependencies": [
        "cn",
        "@base-ui/react",
        "class-variance-authority",
        "lucide-react"
      ],
      "files": [
        {
          "path": "src/components/ui/badge.tsx",
          "type": "registry:ui",
          "target": "@ui/badge.tsx"
        }
      ]
    },
    {
      "name": "card",
      "type": "registry:ui",
      "title": "Card",
      "description": "見出し・説明・本文・フッターを組み合わせるshadcn/uiのカードです。内部のコンテンツに応じて構造を選べます。",
      "dependencies": [
        "cn",
        "@base-ui/react",
        "class-variance-authority",
        "lucide-react"
      ],
      "files": [
        {
          "path": "src/components/ui/card.tsx",
          "type": "registry:ui",
          "target": "@ui/card.tsx"
        }
      ]
    },
    {
      "name": "form-field",
      "type": "registry:component",
      "title": "Form Field",
      "description": "必須表示と入力例を備えた日本語フォームの最小単位。ラベルと補足、エラーを自動生成したIDで入力欄に関連付けます。",
      "dependencies": [
        "cn",
        "@base-ui/react",
        "class-variance-authority",
        "lucide-react"
      ],
      "files": [
