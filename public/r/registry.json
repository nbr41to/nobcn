          "target": "@components/form-field.tsx"
        },
        {
          "path": "src/components/ui/input.tsx",
          "type": "registry:ui",
          "target": "@ui/input.tsx"
        }
      ]
    },
    {
      "name": "file-input",
      "type": "registry:component",
      "title": "File Input",
      "description": "複数ファイルの追加・重複除外・個別削除に対応します。選択内容はネイティブinputと同期し、FormDataにも反映されます。アップロード処理は利用側が実装します。",
      "dependencies": [
        "cn",
        "@base-ui/react",
        "class-variance-authority",
        "lucide-react"
      ],
      "files": [
        {
